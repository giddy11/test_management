{
  "name": "testmate-server",
  "version": "1.0.0",
  "description": "TestMate — Test Case Management API (PERN)",
  "main": "server.js",
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx watch server.js",
    "dev:local": "tsx watch --env-file=.env.dev server.js",
    "typecheck": "tsc --noEmit",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d infrastructure/database/dataSource.js",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d infrastructure/database/dataSource.js",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d infrastructure/database/dataSource.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "env:apply": "gcloud run services update testmate-api --project testmate-f973c --region us-central1 --env-vars-file env.yaml",
    "seed:superadmin": "tsx scripts/seedSuperadmin.js",
    "seed:access": "tsx scripts/seedAccess.js"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/modules/**/tests/**/*.spec.@(js|ts)",
      "**/shared/**/tests/**/*.spec.@(js|ts)"
    ],
    "clearMocks": true,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "infrastructure/database/dataSource$": "<rootDir>/test/dataSource.mock.js"
    }
  },
  "keywords": [
    "testmate",
    "test-management",
    "pern"
  ],
  "author": "Gideon Azibaobuom Edoghotu",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^9.14.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.0",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
