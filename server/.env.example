# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Used to build links in emails; defaults to the API host
APP_BASE_URL=http://localhost:4000

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=testmate
# true for managed providers (Aiven, etc.)
DB_SSL=false
# Optional schema override (defaults to public)
# DB_SCHEMA=public
# Auto-syncs schema when set; defaults to true in development
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (Sign In) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── Email ───────────────────────────────────────────────────────────────────
# How mail is sent: "nodemailer" (Gmail SMTP, the default) or "script" (Google
# Apps Script web app). Switch by changing this one value and restarting.
EMAIL_PROVIDER=nodemailer
EMAIL_PROVIDER=script
# -- nodemailer: Gmail SMTP --
EMAIL_USER=you@gmail.com
# Gmail App Password (not your normal password)
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="TestMate <you@gmail.com>"
# -- script: Google Apps Script web app --
# The web app's /exec URL. Keep it secret — anyone with it can send mail as the
# script owner. Mail is sent from the script owner's account, so EMAIL_FROM is
# not used in this mode.
EMAIL_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# Minutes an emailed OTP stays valid (email verification, password reset)
OTP_TTL_MINUTES=15
# Minutes a "my tickets" lookup code stays valid — read-only, so much longer
# than OTP_TTL_MINUTES. Default 10080 (7 days).
TICKET_LOOKUP_CODE_TTL_MINUTES=10080

# ── Cloudinary (image uploads) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Firestore (realtime feature-request comments) ──────────────────────────
FIREBASE_PROJECT_ID=testmate-f973c
# Paste the full JSON of a Firebase Admin service-account key (local dev only —
# distinct from sa-key.json, which is the Cloud Run deployer key). On Cloud Run,
# leave this unset and grant the runtime service account roles/datastore.user instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
