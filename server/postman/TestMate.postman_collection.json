{
  "info": {
    "name": "TestMate API",
    "description": "Scoped to testing POST /api/v1/integrations/companies (create/provision a client company + IT support lead). Includes just enough of Auth and Projects to obtain a bearer token and a projectId to provision into. Extend with more module folders as needed — this is not yet a complete mirror of the API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000", "type": "string" },
    { "key": "loginEmail", "value": "admin@example.com", "type": "string" },
    { "key": "loginPassword", "value": "ChangeMe123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "supportLeadId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.tokens) {",
                  "  pm.collectionVariables.set(\"accessToken\", res.data.tokens.accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", res.data.tokens.refreshToken);",
                  "}",
                  "if (res.data && res.data.user) pm.collectionVariables.set(\"userId\", res.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Logs in as an admin/superadmin so 'List Projects' below has a bearer token. Set loginEmail/loginPassword to a real account first (e.g. seed one with `npm run seed:superadmin`)."
          },
          "response": [
            {
              "name": "200 Login successful",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"statusCode\": 200,\n  \"data\": {\n    \"user\": {\n      \"id\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n      \"firstName\": \"Admin\",\n      \"lastName\": \"User\",\n      \"name\": \"Admin User\",\n      \"companyName\": \"Acme Inc\",\n      \"email\": \"admin@example.com\",\n      \"isEmailVerified\": true,\n      \"onboardingCompleted\": true,\n      \"role\": \"admin\",\n      \"isOrgOwner\": true,\n      \"provider\": \"local\",\n      \"organizationId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"clientCompanyId\": null,\n      \"isSupportLead\": false,\n      \"avatarUrl\": null,\n      \"address\": null,\n      \"city\": null,\n      \"state\": null,\n      \"country\": null,\n      \"createdAt\": \"2026-01-10T09:00:00.000Z\",\n      \"lastSeenAt\": \"2026-07-17T08:00:00.000Z\"\n    },\n    \"tokens\": {\n      \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjdjOWU2Njc5In0.abc123\",\n      \"refreshToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjdjOWU2Njc5In0.def456\",\n      \"expiresIn\": 900\n    }\n  },\n  \"errors\": []\n}"
            },
            {
              "name": "401 Invalid email or password",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"wrong-password\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "login"]
                }
              },
