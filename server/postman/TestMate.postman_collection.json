              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Validation failed\",\n  \"statusCode\": 422,\n  \"data\": null,\n  \"errors\": [\n    { \"field\": \"body.email\", \"message\": \"Invalid email\" },\n    { \"field\": \"body.password\", \"message\": \"String must contain at least 1 character(s)\" }\n  ]\n}"
            },
            {
              "name": "429 Too many requests",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"ChangeMe123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "login"]
                }
              },
              "status": "Too Many Requests",
              "code": 429,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": false,\n  \"message\": \"Too many requests, please try again later\",\n  \"statusCode\": 429,\n  \"data\": null,\n  \"errors\": []\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Projects",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "  pm.collectionVariables.set(\"projectId\", res.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/projects?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "projects"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Grabs the first project's id into {{projectId}} for the Create Company request below. If you'd rather target a specific project, paste its id into the collection variable directly instead of running this."
          },
          "response": [
            {
              "name": "200 Projects fetched",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/projects?page=1&limit=20",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "projects"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "20" }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Projects fetched\",\n  \"statusCode\": 200,\n  \"data\": [\n    {\n      \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"name\": \"Website Revamp\",\n      \"description\": \"Q3 marketing site rebuild\",\n      \"ownerId\": \"7c9e6679-7425-40de-944b-e07fc1f90ae7\",\n      \"suiteCount\": 4,\n      \"feedbackToken\": null,\n      \"createdAt\": \"2026-06-01T09:00:00.000Z\"\n    }\n  ],\n  \"errors\": [],\n  \"meta\": { \"page\": 1, \"limit\": 20, \"total\": 1, \"totalPages\": 1, \"hasNext\": false, \"hasPrev\": false }\n}"
            },
