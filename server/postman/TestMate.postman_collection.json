    {
      "name": "Integrations — Companies",
      "description": "Server-to-server company provisioning. Unauthenticated by design — the request identifies its target project directly via projectId, not a bearer token or API key.",
      "item": [
        {
          "name": "Create Company (Provision)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.company) pm.collectionVariables.set(\"companyId\", res.data.company.id);",
                  "if (res.data && res.data.supportLead) pm.collectionVariables.set(\"supportLeadId\", res.data.supportLead.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"name\": \"Acme Corp {{$timestamp}}\",\n  \"contactEmail\": \"billing+{{$timestamp}}@acme.example\",\n  \"supportLead\": {\n    \"email\": \"sam.support+{{$timestamp}}@acme.example\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/integrations/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "integrations", "companies"]
            },
            "description": "Creates a client company + its first IT support lead in one shot. `contactEmail` is optional. `supportLead.email` is the only required field for the lead — TestMate derives a display name from it and emails a login link + temp password. The {{$timestamp}} in the sample body keeps repeat runs from colliding on unique-email constraints; replace with fixed values to deliberately test the 409 cases below."
          },
          "response": [
            {
              "name": "201 Client company provisioned",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"projectId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n  \"name\": \"Acme Corp\",\n  \"contactEmail\": \"billing@acme.example\",\n  \"supportLead\": {\n    \"email\": \"sam.support@acme.example\"\n  }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/integrations/companies",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "integrations", "companies"]
                }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Client company provisioned\",\n  \"statusCode\": 201,\n  \"data\": {\n    \"company\": {\n      \"id\": \"9b2f1e10-6b1a-4c9e-8a2d-1a2b3c4d5e6f\",\n      \"projectId\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"name\": \"Acme Corp\",\n      \"contactEmail\": \"billing@acme.example\",\n      \"feedbackToken\": null,\n      \"supporterCount\": 0,\n      \"createdAt\": \"2026-07-17T10:00:00.000Z\"\n    },\n    \"supportLead\": {\n      \"id\": \"c1d2e3f4-5678-4abc-9def-0123456789ab\",\n      \"firstName\": \"Sam\",\n      \"lastName\": \"Support\",\n      \"name\": \"Sam Support\",\n      \"email\": \"sam.support@acme.example\",\n      \"isSupportLead\": true,\n      \"createdAt\": \"2026-07-17T10:00:00.000Z\",\n      \"lastSeenAt\": null\n    }\n  },\n  \"errors\": []\n}"
            },
            {
              "name": "404 Project not found",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
