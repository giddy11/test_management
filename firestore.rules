rules_version = '2';

// Realtime collections (feature-request comments, support-chat messages). Writes
// only ever happen through the server's Firebase Admin SDK (which bypasses these
// rules) — ownership/authorization checks live in the corresponding server
// services, not here. Clients only ever read, via an anonymous Firebase sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /featureRequestComments/{commentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Support-chat messages. NOTE: an anonymous sign-in carries no app identity,
    // so these rules can only require "authenticated", not "is a participant" —
    // read access is at parity with featureRequestComments. Keep sensitive data
    // out of message bodies until a stricter server-gated read path exists.
    match /supportChatMessages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Ticket comment threads. Unlike the two collections above, one of the
    // legitimate readers here is a genuinely anonymous member of the public
    // (a ticket submitter with no TestMate account) — not just an
    // already-logged-in app user taking a secondary read path. Their only
    // credential is the ticket's id (an unguessable uuid), the same bearer-
    // credential trust model already used by the public confirmation page
    // (see FeedbackService.getPublicConfirmationContext) and the "My Tickets"
    // email+code lookup. The server independently re-verifies that email+code
    // pair before ever writing to a thread — these rules only gate reads.
    match /feedbackComments/{commentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Live-chat widget messages. Same trust model as feedbackComments above —
    // the widget signs the visitor in anonymously, and their real credential
    // (the visitor id issued on first load) is re-verified server-side before
    // any write, not by these rules.
    match /liveChatMessages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
