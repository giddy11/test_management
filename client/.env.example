# Base URL of the TestMate API
VITE_API_URL=http://localhost:4000

# Google OAuth client ID (same value as the server's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Firestore (realtime feature-request comments) — from a Firebase Web App under
# the testmate-f973c project. Not secret: Firestore access is gated by security
# rules, not by hiding this config.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=testmate-f973c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=testmate-f973c
