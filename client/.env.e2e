# Loaded by `npm run dev:e2e` (vite --mode e2e). Safe to commit — no secrets.
#
# The API URL points at a dead local port on purpose: the Cypress suite stubs
# every API call with cy.intercept(), and any request a test forgets to stub
# should fail immediately instead of reaching the shared dev/prod database
# (dev and prod share one Aiven Postgres — E2E tests must never write to it).
VITE_API_URL=http://127.0.0.1:4545

# Placeholders so the app boots in CI where the gitignored .env is absent.
# Google sign-in and Firestore comments are not exercised by the E2E suite.
VITE_GOOGLE_CLIENT_ID=e2e-placeholder.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=e2e-placeholder
VITE_FIREBASE_AUTH_DOMAIN=e2e-placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=e2e-placeholder
